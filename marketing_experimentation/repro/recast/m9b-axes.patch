+# ── M9-B: design axes as SLICES OF ONE MAXIMAL WORLD ──────────────────
+#
+#   --post_days 15 --n_control 5
+#
+# Both flags or neither. They select a slice; they do NOT size the world.
+#
+# Why this exists. The donor's own knobs cannot express a design axis
+# honestly. `draw_baselines()` calls rlnorm(n_geos) and then sort()s, so a
+# 6-geo draw is not a prefix of a 10-geo draw even at the same seed; and
+# `select_treated()` picks the geo nearest the MEDIAN, which moves with pool
+# size. Measured at seed 52001: treated geo is City 3 / City 5 / City 11 /
+# City 21 at n_geos = 6 / 10 / 21 / 41. The noise loop is `for (geo) { for
+# (day) }`, so raising total_days shifts the stream for every geo after the
+# first -- T = 15 is not a prefix of T = 42 either. Varying the donor's knobs
+# therefore changes the WORLD as well as the design, and any cell-to-cell
+# difference confounds the two. See docs/m9-preregistration.md.
+#
+# The fix is to generate one maximal latent world per replication and read
+# the cells out of it:
+#
+#   world   pre_days (90) + MAX_POST_DAYS days, n_treated + MAX_CONTROLS geos
+#   treated chosen ONCE from the maximal world, by the unchanged median rule
+#   donors  the remaining MAX_CONTROLS geos in a fixed random order, so the
+#           pools nest by prefix: D5 subset D9 subset D20 subset D40
+#   days    prefix: Y15 subset Y21 subset Y28 subset Y42
+#
+# MAX_* and requested_* are named apart on purpose. If a later
+# "optimisation" generates a world sized to the request, every nesting
+# property above dies silently and the design axis stops meaning what it
+# says. The stopifnot() in the main loop is the tripwire; the metamorphic
+# tests in repro/recast/m9b_world_check.py are the proof.
+MAX_POST_DAYS <- 42L
+MAX_CONTROLS  <- 40L
+
+# The world is the A1 world. Pinned rather than derived from
+# match(sc_id, names(scenarios)), so that "every M9-B cell shares one world"
+# is a stated contract and not an accident of the scenarios list having one
+# element.
+M9B_SEED_SLOT <- 1L
+
+# Dedicated substream for the donor permutation. It must not be drawn from
+# the DGP's noise stream: the donor ordering has to be identical for every
+# theta, T, G_c and tool, and a stream shared with the DGP would move with
+# any of them. panel_seed lies in [52001, 82025] for this study, so the
+# three offsets (0 baselines, 1e5 noise, 9e5 permutation) cannot collide.
+M9B_PERM_SEED_OFFSET <- 900000L
+
+requested_post_days <- parse_cli("--post_days", NA)
+requested_n_control <- parse_cli("--n_control", NA)
+m9b_mode <- !is.na(requested_post_days) || !is.na(requested_n_control)
+if (m9b_mode) {
+  # Partial flags REFUSE. A run with only one axis set would silently take
+  # the other from the donor defaults, and the resulting cell would not be a
+  # slice of the same world as its neighbours.
+  if (is.na(requested_post_days) || is.na(requested_n_control)) {
+    stop("--post_days and --n_control must be given together (M9-B mode). ",
+         "One without the other would silently mix a sliced axis with a ",
+         "donor default.")
+  }
+  requested_post_days <- as.integer(requested_post_days)
+  requested_n_control <- as.integer(requested_n_control)
+  if (is.na(requested_post_days) || requested_post_days < 1L ||
+      requested_post_days > MAX_POST_DAYS) {
+    stop("--post_days must be an integer in 1..", MAX_POST_DAYS)
+  }
+  if (is.na(requested_n_control) || requested_n_control < 1L ||
+      requested_n_control > MAX_CONTROLS) {
+    stop("--n_control must be an integer in 1..", MAX_CONTROLS)
+  }
+}
